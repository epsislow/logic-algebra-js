# Copiază în Supabase Dashboard → Edge Functions → Secrets (sau supabase secrets set)

# Obligatoriu — același secret în pg_cron (Vault) și la test curl
CRON_SECRET=genereaza-un-string-lung-random

# Job implicit pentru smoke (opțional)
CRON_DEFAULT_KEY=cron:testPing

# Redis — aceleași valori ca pe Worker (nume acceptate: ambele variante)
UPSTASH_URL=https://xxxx.upstash.io
UPSTASH_TOKEN=xxxx
# sau: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN

# Redis — variantă B: prin Worker (user dedicat cron, parolă în Redis user:...)
# SSIDE_WORKER_URL=https://little-darkness-9133.ady25626.workers.dev
# SSIDE_CRON_USERNAME=cron_bot
# SSIDE_CRON_PASSWORD=...
